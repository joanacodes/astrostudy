{
  // The Astro Study on Cloudflare Workers, deployed by .github/workflows/deploy.yml (see README).
  // The built Hugo site (public/) is served as static files; worker/index.js only runs for
  // /api/* — the sky of the day — so every other request costs nothing.
  "name": "the-astro-study",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /fr/… pages that don't exist get the French 404, the others the English one
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
